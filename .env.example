# ============================================================================
# YueXia Docker 部署配置 —— 复制为 .env 后按本机情况修改
#   cp .env.example .env
# 这些是与「机器相关 / 需迁移」的变量，避免写死在 compose 或代码里
# ============================================================================

# 本地 LLM 模型目录（宿主机绝对路径，会以只读方式挂载到容器 /models/llm）
# 例：MODEL_DIR=/home/user/models/Qwen3-VL-4B-Instruct
# 例(Windows Docker Desktop)：MODEL_DIR=E:/models/Qwen3-VL-4B-Instruct
# 若用远程 API 模式(brain.engine=api)，可留空或随意指向一个空目录
MODEL_DIR=./.empty_model

# 是否在容器内启动 GPT-SoVITS TTS（1=启动，0=关闭。关闭则语音合成不可用，其余功能正常）
START_TTS=1

# 对外暴露的端口（宿主端口；若与本机已有服务冲突可改这里）
FRONTEND_PORT=5173
BACKEND_PORT=5000
TTS_PORT=9880
