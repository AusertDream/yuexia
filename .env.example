# ============================================================================
# YueXia Docker 部署配置 —— 复制为 .env 后按本机情况修改
#   cp .env.example .env
# 这些是与「机器相关 / 需迁移」的变量，避免写死在 compose 或代码里
# ============================================================================

# 本地 LLM 模型目录（宿主机绝对路径，会以只读方式挂载到容器 /models/llm）
# 任意 Qwen-VL 系列模型均可（如 Qwen3-VL-4B / 8B / 30B-Instruct 等）
# 例(Linux)  ：MODEL_DIR=/path/to/model
# 例(Windows)：MODEL_DIR=E:/path/to/model
# 若用远程 API 模式(brain.engine=api)，可留空或随意指向一个空目录
MODEL_DIR=/path/to/model

# 是否在容器内启动 GPT-SoVITS TTS（1=启动，0=关闭。关闭则语音合成不可用，其余功能正常）
START_TTS=1

# 对外暴露的前端端口（宿主端口；若与本机已有服务冲突可改这里）
# 后端 5000 与 TTS 9880 仅在容器网络内可见，不映射到宿主机
FRONTEND_PORT=5173
